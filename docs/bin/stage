#!/usr/bin/env bash
#
# Prepare the docs directory for a Jekyll build.
#
# The markdown sources carry no front matter, so they render cleanly on GitHub
# and in any editor. Jekyll needs front matter, so it is prepended here into
# generated copies under pages/ instead. CI and a local preview both run this,
# so the two cannot drift.

set -euo pipefail

cd "$(dirname "$0")/.."

rm -rf pages
mkdir -p pages

stage() {
    local source="$1" slug="$2" title="$3" order="$4"

    {
        printf -- '---\nlayout: default\ntitle: %s\nnav_order: %s\npermalink: /%s/\n---\n\n' \
            "$title" "$order" "$slug"

        # The bodies contain Blade and other {{ ... }} syntax that Liquid would
        # otherwise try to evaluate and swallow. None of these documents use
        # Liquid deliberately, so the whole body is passed through untouched.
        printf -- '{%% raw %%}\n'
        cat "$source"
        printf -- '\n{%% endraw %%}\n'
    } > "pages/${slug}.md"
}

# The README is the guide. Copying it in keeps one source of truth rather than
# a second copy that drifts. It is split at its h2 headings into child pages
# under a Guide parent, which is what puts the guide's sections into the left
# sidebar as a submenu instead of one endless page with an on-page contents
# box. Anchors keep kramdown's ids, and every intra-document link is rewritten
# to the page its target now lives on.
python3 - <<'SPLIT'
import re
from pathlib import Path

readme = Path('../README.md').read_text()

# The docs link under the title is circular once you are on the site, and
# links written for GitHub readers point at docs/ rather than sibling pages.
readme = re.sub(r'^\[Documentation\]\(https://obaid\.github\.io.*\n', '', readme, flags=re.M)
readme = readme.replace('](docs/RECIPES.md)', '](/laravel-clutch/recipes/)')

def slugify(title: str) -> str:
    # kramdown's auto_ids: lowercase, spaces to hyphens, drop punctuation.
    slug = title.strip().lower()
    slug = re.sub(r'[^a-z0-9 -]', '', slug)
    slug = re.sub(r'\s+', '-', slug).strip('-')
    return slug or 'section'

lines = readme.split('\n')
sections = []      # (title, [body lines])
intro = []
current = None

for line in lines:
    heading = re.match(r'^## (.+)$', line)
    if heading:
        current = (heading.group(1).strip(), [])
        sections.append(current)
        continue
    (current[1] if current else intro).append(line)

# Where every anchor lives now, for link rewriting. The h2's own anchor maps
# to its page root; deeper headings keep their kramdown id on that page.
anchor_page = {}
for title, body in sections:
    page = slugify(title)
    anchor_page[page] = (page, '')
    for line in body:
        sub = re.match(r'^#{3,6} (.+)$', line)
        if sub:
            anchor_page[slugify(sub.group(1))] = (page, slugify(sub.group(1)))

def rewrite_links(text: str) -> str:
    def repl(match):
        anchor = match.group(1)
        if anchor not in anchor_page:
            return match.group(0)
        page, fragment = anchor_page[anchor]
        target = f'/laravel-clutch/guide/{page}/'
        return f']({target}#{fragment})' if fragment else f']({target})'
    return re.sub(r'\]\(#([a-z0-9-]+)\)', repl, text)

def write(path, front, body):
    Path(path).write_text(front + '\n{% raw %}\n' + rewrite_links(body).strip() + '\n{% endraw %}\n')

write('pages/guide.md',
    '---\nlayout: default\ntitle: Guide\nnav_order: 1\nhas_children: true\nhas_toc: false\npermalink: /guide/\n---\n',
    '\n'.join(intro))

for order, (title, body) in enumerate(sections, start=1):
    page = slugify(title)
    safe_title = title.replace('"', '\\"')
    write(f'pages/guide-{page}.md',
        f'---\nlayout: default\ntitle: "{safe_title}"\nparent: Guide\nnav_order: {order}\npermalink: /guide/{page}/\n---\n',
        '\n'.join(body))

print(f'guide split into {len(sections)} sections')
SPLIT

stage RECIPES.md recipes 'Recipes' 2
stage AGENT-SETUP.md agents 'Set it up with an agent' 3

# One plain-text file holding everything, for agents that would rather read the
# whole thing in one request than crawl three pages. Built from the same
# sources, so it cannot drift from the site.
rule=$(printf -- '-%.0s' {1..76})

{
    printf -- '# Laravel Clutch\n\n'
    printf -- 'The complete documentation as one file: the guide, then the recipes.\n'
    printf -- 'Source: https://github.com/obaid/laravel-clutch\n'
    printf -- 'Short index for agents: https://obaid.github.io/laravel-clutch/llms.txt\n\n'
    printf -- '%s\n\n' "$rule"
    cat ../README.md
    printf -- '\n\n%s\n\n' "$rule"
    cat RECIPES.md
} > llms-full.txt

echo "Staged: $(ls pages) llms-full.txt"
