#!/usr/bin/env bash
#
# Prepare the docs directory for a Jekyll build.
#
# The markdown sources carry no front matter, so they render cleanly on GitHub
# and in any editor. Jekyll needs front matter, so it is prepended here into
# generated copies under pages/ instead. CI and a local preview both run this,
# so the two cannot drift.

set -euo pipefail

cd "$(dirname "$0")/.."

rm -rf pages
mkdir -p pages

stage() {
    local source="$1" slug="$2" title="$3" order="$4"

    {
        printf -- '---\nlayout: default\ntitle: %s\nnav_order: %s\npermalink: /%s/\n---\n\n' \
            "$title" "$order" "$slug"

        # The bodies contain Blade and other {{ ... }} syntax that Liquid would
        # otherwise try to evaluate and swallow. None of these documents use
        # Liquid deliberately, so the whole body is passed through untouched.
        printf -- '{%% raw %%}\n'
        cat "$source"
        printf -- '\n{%% endraw %%}\n'
    } > "pages/${slug}.md"
}

# The README is the guide. Copying it in keeps one source of truth rather than
# a second copy that drifts.
stage ../README.md guide 'Guide' 1

# Two fixes for the site copy: the docs links under the title are circular
# once you are already on the site, and links written for GitHub readers point
# at docs/ rather than at sibling pages.
sed -i.bak \
    -e '/^\[Documentation\](https:\/\/obaid.github.io/d' \
    -e 's|](docs/RECIPES.md)|](/laravel-clutch/recipes/)|g' \
    pages/guide.md && rm -f pages/guide.md.bak

# The guide is one long page, so give it an on-page contents list. Inserted
# before the first h2 rather than written into the README, where GitHub already
# renders its own outline.
awk '
    !done && /^## / {
        print "<details open markdown=\"block\">"
        print "<summary>On this page</summary>"
        print ""
        print "- TOC"
        print "{:toc}"
        print ""
        print "</details>"
        print ""
        done = 1
    }
    { print }
' pages/guide.md > pages/guide.tmp && mv pages/guide.tmp pages/guide.md

stage RECIPES.md recipes 'Recipes' 2
stage AGENT-SETUP.md agents 'Set it up with an agent' 3

# One plain-text file holding everything, for agents that would rather read the
# whole thing in one request than crawl three pages. Built from the same
# sources, so it cannot drift from the site.
rule=$(printf -- '-%.0s' {1..76})

{
    printf -- '# Laravel Clutch\n\n'
    printf -- 'The complete documentation as one file: the guide, then the recipes.\n'
    printf -- 'Source: https://github.com/obaid/laravel-clutch\n'
    printf -- 'Short index for agents: https://obaid.github.io/laravel-clutch/llms.txt\n\n'
    printf -- '%s\n\n' "$rule"
    cat ../README.md
    printf -- '\n\n%s\n\n' "$rule"
    cat RECIPES.md
} > llms-full.txt

echo "Staged: $(ls pages) llms-full.txt"
