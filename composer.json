{
    "name": "obaid/laravel-clutch",
    "description": "The durable runtime layer for Laravel AI agents. Sessions, resumable runs, replayable events, human approvals, and budgets.",
    "keywords": [
        "laravel",
        "ai",
        "agents",
        "clutch",
        "durable",
        "queue",
        "harness"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Obaid Ahmed",
            "email": "obaid@magicallyhq.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "laravel/ai": "^0.11"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.26",
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.1|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Clutch\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clutch\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clutch\\Laravel\\ClutchServiceProvider"
            ],
            "aliases": {
                "Clutch": "Clutch\\Laravel\\Facades\\Clutch"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    }
}
